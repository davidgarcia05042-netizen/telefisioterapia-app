<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 11 o anterior. La app guarda el token de sesión y una copia de las
   rutinas del paciente: nada de eso va a la copia de seguridad.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
