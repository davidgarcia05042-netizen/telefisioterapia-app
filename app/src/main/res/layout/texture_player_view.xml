<?xml version="1.0" encoding="utf-8"?>
<!--
    PlayerView con TextureView en lugar de SurfaceView (por defecto). Un
    SurfaceView no se desvanece con la transición de navegación: el video
    quedaba a la vista una fracción de segundo cuando el resto de la pantalla
    ya había desaparecido (M5). El tipo de superficie solo se elige desde XML.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view" />
